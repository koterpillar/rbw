{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/*.y*ml"],
      "matchStrings": ["--package (?<depName>@?[^@]+)@(?<currentValue>\\d+)"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["actions/node-versions"],
      "extractVersion": "^(?<version>v\\d+)"
    }
  ],
  "forkProcessing": "enabled"
}
